POSTGRES_USER=polishpro
POSTGRES_PASSWORD=change_me
POSTGRES_DB=polishpro
ADMIN_PASSWORD=change_admin_password
JWT_SECRET=change_jwt_secret
# Encrypts the saved Gmail app password. At least 32 characters; generate with: openssl rand -hex 32
ENCRYPTION_KEY=change_me_to_a_random_value_of_32_chars_or_more
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=no-reply@yourdomain.com
MAIL_TO=your-admin-email@yourdomain.com

# Production only (docker-compose.prod.yml)
# Your site address without https://. Use 'localhost' to test locally.
DOMAIN=localhost
