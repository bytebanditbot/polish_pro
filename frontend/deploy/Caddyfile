# DOMAIN comes from the environment (docker-compose.prod.yml).
#   DOMAIN=localhost          -> local test with a self-signed certificate
#   DOMAIN=polishpro.example  -> real certificate from Let's Encrypt, renewed automatically
{$DOMAIN:localhost} {
	encode zstd gzip

	# API and uploaded images go to the backend. Uploads are capped at 10 MB here, 8 MB in the app.
	handle /api/* {
		request_body {
			max_size 10MB
		}
		reverse_proxy backend:4000
	}

	# Everything else is the built React site.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Hashed build files never change, so browsers can keep them for a year.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
